package-as: NorskenAuras
enable-nolib-creation: no

curse-id: 1787597

required-dependencies:
    - norskencore

move-folders:
    NorskenAuras/NorskenAuras_Options: NorskenAuras_Options

ignore:
    - README.md
    - .git/
    - .github/
    - .vscode/
    - .claude/
    - .pkgmeta
    - release.sh
    - VERSION
    - .gitignore
    - .gitattributes
    - .wowluarc.json
